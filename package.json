{
  "name": "companion-life",
  "version": "1.2.0",
  "description": "Astra plugin: the avatar lives a life of her own — needs, a mood, pastimes and a day",
  "license": "MIT",
  "author": "Taill",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun install --frozen-lockfile && esbuild src/index.ts --bundle --platform=node --format=cjs --loader:.glb=binary --loader:.png=binary --loader:.vrma=binary --outfile=dist/index.js",
    "pretest": "esbuild src/index.ts --bundle --platform=node --format=cjs --external:astra-plugin-sdk --loader:.glb=binary --loader:.png=binary --loader:.vrma=binary --outfile=test/.build/plugin.cjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "astra-plugin-sdk": "^0.7.0",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
